# Copy this to .env and fill in real values before deploying (NFR-01 / DP-19).
# Local dev works fine with none of these set.

# Where uploaded resumes are kept. Defaults to backend/storage.
# HIRELENS_STORAGE_DIR=/var/lib/hirelens/storage

# Where candidates' previous analysis results are kept (FR-10). Defaults to
# the history folder inside the storage folder.
# HIRELENS_HISTORY_DIR=/var/lib/hirelens/storage/history

# The database behind the API (DP-61). Any SQLAlchemy URL. Defaults to a
# SQLite file, hirelens.db, inside the storage folder; use Postgres in
# production, for example:
# HIRELENS_DATABASE_URL=postgresql+psycopg://hirelens:password@localhost/hirelens

# The key resumes are encrypted at rest with. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without this, a random key is generated per process start, so a restart
# makes every resume saved before it unreadable (acceptable here since
# resumes are deleted automatically within 24 hours anyway - DP-29 - but
# set a real key before deploying so a routine restart doesn't look broken).
# HIRELENS_ENCRYPTION_KEY=

# Set to "true" once there's a real TLS certificate in front of the app (a
# reverse proxy, load balancer or hosting platform - DP-34). Redirects HTTP
# to HTTPS and sends Strict-Transport-Security. Leave unset for local dev.
# HIRELENS_FORCE_HTTPS=true

# The session cookies are marked Secure, so browsers send them only over
# HTTPS (DP-62). Browsers treat http://localhost as secure, so leave this
# unset; set it to "false" only for a local browser that refuses Secure
# cookies on http://localhost. Never set it in a deployment.
# HIRELENS_COOKIE_SECURE=false

# Logging in with Google (DP-63). Make an OAuth client ID of type "Web
# application" in the Google Cloud console, with
# https://<your site>/api/auth/google/callback (and, for local dev,
# http://localhost:5173/api/auth/google/callback) as an authorized redirect
# URI. Without both values, Google login is turned off.
# HIRELENS_GOOGLE_CLIENT_ID=
# HIRELENS_GOOGLE_CLIENT_SECRET=
# The callback URL exactly as registered with Google. Worked out from each
# request when unset, which suits local dev; set it in a deployment behind a
# proxy, for example:
# HIRELENS_GOOGLE_REDIRECT_URI=https://hirelens.example/api/auth/google/callback
